# Copy to .env for local development. Azure access uses managed identity (or your `az login`
# session locally), so the only secret is the demo key, and .env is git-ignored.
RAG_ENVIRONMENT=local
RAG_LOG_LEVEL=INFO

# Azure endpoints (required for ingestion; Search and OpenAI also for /chat)
# RAG_AZURE_STORAGE_ACCOUNT_URL=https://<storage-account>.blob.core.windows.net/
# RAG_AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net/
# RAG_AZURE_OPENAI_ENDPOINT=https://<openai-resource>.openai.azure.com/

# Ingestion (defaults shown)
# RAG_BLOB_CONTAINER_NAME=govuk-guidance
# RAG_SEARCH_INDEX_NAME=govuk-guidance
# RAG_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# RAG_EMBEDDING_DIMENSIONS=1536
# RAG_CHUNK_MAX_CHARS=1500
# RAG_CHUNK_OVERLAP_CHARS=200

# Answering (defaults shown)
# RAG_CHAT_DEPLOYMENT=gpt-4o-mini
# RAG_RETRIEVAL_TOP_K=5
# RAG_RELEVANCE_THRESHOLD=0.35
# RAG_MAX_OUTPUT_TOKENS=500

# Access: the shared demo key that /chat requires in the X-Demo-Key header.
# /chat rejects every request while this is unset. Pick any long random string locally.
# RAG_DEMO_KEY=
